# Expo Mobile App Environment Variables
# Copy this file to .env and fill in your values

# App name used for deep linking scheme and storage prefix
# Must match the "scheme" in app.json (default: "mobile")
EXPO_PUBLIC_APP_NAME="mobile"

# Backend API URL
# Use your local IP address for development (not localhost!)
# Find your IP with: ipconfig (Windows) or ifconfig (Mac/Linux)
# Example: http://192.168.1.100:3010
EXPO_PUBLIC_BASE_API_URL=http://YOUR_LOCAL_IP:3010
